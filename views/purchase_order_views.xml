<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_indoor_compras" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.indoor.compras</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id' and @groups='base.group_multi_currency']" position="after">
                <label for="destination"/>
                <div class="o_row">
                    <field name="destination"/>
                    <field name="sale_note"
                           placeholder="Nota de Venta"
                           invisible="destination != 'sale_note'"
                           required="destination == 'sale_note'"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="sale_note"
                       column_invisible="not parent.sale_note"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
